{
  "name": "@ultimatellm/desktop",
  "productName": "UltimateLLM",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "UltimateLLM desktop app",
  "author": "UltimateLLM contributors",
  "homepage": "https://github.com/JamesKLadd/ultimatellm",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:mock": "electron-vite dev -- --mock-providers",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json && tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "package": "electron-vite build && electron-builder --publish never",
    "package:dir": "electron-vite build && electron-builder --dir --publish never"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@ultimatellm/accounts": "workspace:*",
    "@ultimatellm/core": "workspace:*",
    "@ultimatellm/db": "workspace:*",
    "@ultimatellm/providers": "workspace:*",
    "@ultimatellm/shared": "workspace:*",
    "@ultimatellm/ui": "workspace:*",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "44.7.0",
    "electron-builder": "^26.17.0",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.3",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  }
}
